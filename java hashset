import java.util.*;
import java.io.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();
        HashSet<String> set = new HashSet<>();

        while (t-- > 0) {
            String left = sc.next();
            String right = sc.next();

            set.add(left + " " + right);
            System.out.println(set.size());
        }

        sc.close();
    }
}
